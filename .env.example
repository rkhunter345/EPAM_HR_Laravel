APP_NAME="EPAM HR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos -------------------------------------------------------
# SQLite (por defecto, no requiere servidor)
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database/database.sqlite

# MySQL / MariaDB (descomentar para usar el servidor de la empresa)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=epam_hr
# DB_USERNAME=epam
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Asistente / LLM (opcional) -----------------------------------------
LLM_API_URL=
LLM_API_KEY=
LLM_MODELO=gpt-4o-mini

# --- Cámara IoT por estación de trabajo (opcional) ----------------------
CAMARA_INDICE=0
TOLERANCIA_VERIFICACIONES=3
INTERVALO_SEGUNDOS=30
NOMBRE_ESTACION=estacion-1

# --- Asistente inteligente (Ollama local) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=llama3.2

# --- Módulo IoT (token de las estaciones/cámaras) -----------------------
# Genere un valor aleatorio propio, p. ej.: php -r "echo bin2hex(random_bytes(16));"
# Si IOT_TOKEN está vacío, la API /api/iot/evento rechaza todos los eventos.
IOT_TOKEN=
